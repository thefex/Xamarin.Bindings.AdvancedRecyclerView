<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:local="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <Button
        android:id="@+id/btn_add"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/add_item"
        android:layout_margin="8dp"
        local:MvxBind="Click AddItemCommand" />

    <mvvmcross.advancedrecyclerview.MvxAdvancedNonExpandableRecyclerView
        android:id="@+id/recycler_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        local:MvxBind="ItemsSource Items"
        local:MvxItemTemplate="@layout/item_simple_list"
        local:MvxSwipeableTemplate="@string/simple_list_swipeable_template"
        local:MvxUniqueItemIdProvider="@string/simple_list_unique_id_provider" />

</LinearLayout>
