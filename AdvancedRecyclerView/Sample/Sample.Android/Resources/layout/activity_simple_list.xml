<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:local="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <Button
        android:id="@+id/btn_add"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/add_item"
        android:layout_margin="8dp"
        local:MvxBind="Click AddItemCommand" />

    <mvvmcross.advancedrecyclerview.MvxAdvancedNonExpandableRecyclerView
        android:id="@+id/recycler_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        local:MvxBind="ItemsSource Items"
        local:MvxItemTemplate="@layout/item_simple_list"
        local:MvxSwipeableTemplate="Sample.Android.Adapters.SimpleList.SimpleListSwipeableTemplate, Sample.Android"
        local:MvxUniqueItemIdProvider="Sample.Android.Adapters.SimpleList.SimpleListUniqueIdProvider, Sample.Android" />

</LinearLayout>
