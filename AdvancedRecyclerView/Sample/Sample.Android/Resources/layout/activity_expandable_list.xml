<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:local="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <mvvmcross.advancedrecyclerview.MvxAdvancedExpandableRecyclerView
        android:id="@+id/recycler_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        local:MvxBind="ItemsSource Items"
        local:MvxItemTemplate="@layout/item_expandable_child"
        local:MvxGroupedDataConverter="Sample.Android.Adapters.Expandable.SampleGroupedDataConverter, Sample.Android"
        local:MvxTemplateSelector="Sample.Android.Adapters.Expandable.SampleExpandableTemplateSelector, Sample.Android"
        local:MvxGroupExpandController="MvvmCross.AdvancedRecyclerView.Utils.DefaultMvxGroupExpandController, MvvmCross.AdvancedRecyclerView" />

</LinearLayout>
