<?xml version="1.0" encoding="utf-8"?>
<!-- Root frame: under-swipe (delete background) visible beneath the swipeable container -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:local="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <!-- Under-swipe background (delete indicator) -->
    <LinearLayout
        android:id="@+id/under_swipe_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/swipe_delete_background"
        android:gravity="center_vertical|end"
        android:paddingEnd="24dp"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/delete"
            android:textColor="@android:color/white"
            android:textSize="16sp" />

    </LinearLayout>

    <!-- Swipeable foreground -->
    <LinearLayout
        android:id="@+id/swipe_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/item_background"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:textStyle="bold"
            local:MvxBind="Text Title" />

        <TextView
            android:id="@+id/tv_description"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="@android:color/darker_gray"
            local:MvxBind="Text Description" />

    </LinearLayout>

</FrameLayout>
