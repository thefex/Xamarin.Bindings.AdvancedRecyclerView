<metadata>
  <!--
    BaseWrapperAdapter uses a generic VH type parameter. The binder generates an incorrect
    JNI callback that casts VH to Java.Lang.Object instead of RecyclerView.ViewHolder.
    Remove both methods and provide hand-written implementations in Additions/BaseWrapperAdapterExtensions.cs.
  -->
  <remove-node path="/api/package[@name='com.h6ah4i.android.widget.advrecyclerview.utils']/class[@name='BaseWrapperAdapter']/method[@name='onBindViewHolder' and count(parameter)=2 and parameter[1][@type='VH'] and parameter[2][@type='int']]"/>
  <remove-node path="/api/package[@name='com.h6ah4i.android.widget.advrecyclerview.utils']/class[@name='BaseWrapperAdapter']/method[@name='onCreateViewHolder' and count(parameter)=2 and parameter[1][@type='android.view.ViewGroup'] and parameter[2][@type='int']]"/>

  <!--
    BaseItemAnimationManager and its typed sub-managers use internal generic
    animation-info types that cannot be resolved cleanly from C#. Removing the
    base class from the generated API avoids CS0534 errors on all concrete
    subclasses (RefactoredDefaultItemAnimator.Default*, SwipeDismissItemAnimator.*).
    The Java-side implementations are still called at runtime via JNI.
  -->
  <remove-node path="/api/package[@name='com.h6ah4i.android.widget.advrecyclerview.animator.impl']/class[@name='BaseItemAnimationManager']" />
</metadata>

