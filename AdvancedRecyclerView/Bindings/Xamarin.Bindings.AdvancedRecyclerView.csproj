<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>21</SupportedOSPlatformVersion>
    <TargetPlatformVersion>36.0</TargetPlatformVersion>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform> 
    <OutputType>Library</OutputType>
    <AppDesignerFolder>Properties</AppDesignerFolder>
    <RootNamespace>Xamarin.Bindings.AdvancedRecyclerView</RootNamespace>
    <AssemblyName>Xamarin.Bindings.AdvancedRecyclerView</AssemblyName>
    <FileAlignment>512</FileAlignment>

    <!-- NuGet package metadata -->
    <PackageId>Xamarin.Bindings.AdvancedRecyclerView</PackageId>
    <Version>1.4.0</Version>
    <Authors>thefex</Authors>
    <Description>.NET Android binding library for the AdvancedRecyclerView library (https://github.com/h6ah4i/android-advancedrecyclerview). Provides drag &amp; drop, swipe-to-dismiss, expandable/grouped lists, and header/footer support for AndroidX RecyclerView.</Description>
    <PackageTags>android;recyclerview;advancedrecyclerview;xamarin;dotnet;bindings;androidx;drag-drop;swipe</PackageTags>
    <PackageProjectUrl>https://github.com/thefex/Xamarin.Bindings.AdvancedRecyclerView</PackageProjectUrl>
    <RepositoryUrl>https://github.com/thefex/Xamarin.Bindings.AdvancedRecyclerView</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <OutputPath>bin\Debug\</OutputPath>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>bin\Release\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>
  
  <ItemGroup>
    <!-- AAR built from android-advancedrecyclerview submodule via build-aar.sh -->
    <AndroidLibrary Include="Jars\advrecyclerview.aar" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Xamarin.AndroidX.RecyclerView" Version="1.4.0.5" />
  </ItemGroup>
</Project>